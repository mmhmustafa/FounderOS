# PR-A0: deterministic sdist composition.
#
# Before this file existed the sdist was unenumerated: 693 files including
# the entire tests/ tree (174 files, one carrying a verbatim third-party
# device banner). A source distribution is a DISTRIBUTION — its contents
# are an allow-list decision, not an accident.
#
# compliance/ travels with the sdist so the runtime manifest, the licence
# policy, the canonical licence texts and the LGPL/MPL corresponding-source
# archives ship beside the code they describe. THIRD-PARTY-NOTICES.txt is
# included explicitly: A2a does not set [project] license-files (that is
# A2b), so nothing else would carry it into the sdist.

graft compliance
include THIRD-PARTY-NOTICES.txt

prune tests
prune docs

# Local operational data must never enter any distribution. These
# directories are untracked and gitignored; the prunes make the guarantee
# hold even for an sdist built from a working tree that contains them.
prune .atlas
prune configs
prune enterprise-memory
prune deliverables
prune _zip

# Tracked source-tree snapshots (pending removal in Stage A2) and any
# future archive must not ride along.
global-exclude *.zip
